<div class="heroism-gm-content">
  <p class="heroism-gm-intro">Персональное состояние жетонов и Апофеоза каждого игрока.</p>
  {{#if players.length}}
    <div class="heroism-player-list">
      {{#each players as |player|}}
        <article class="heroism-player-card">
          <div class="heroism-player-heading">
            <strong>{{player.name}}</strong>
            <span class="heroism-player-count">{{player.count}} / 5</span>
            <span class="heroism-presence {{#if player.active}}online{{else}}offline{{/if}}">
              {{#if player.active}}В сети{{else}}Не в сети{{/if}}
            </span>
          </div>
          <div class="heroism-gm-token-row">
            {{#each player.tokens as |active index|}}
              <span class="heroism-gm-token {{#if active}}is-active{{else}}is-inactive{{/if}}" title="Жетон {{add index 1}}">
                <img src="modules/heroism-tokens/assets/heroism-coin.webp" alt="">
              </span>
            {{/each}}
          </div>
          <div class="heroism-gm-apotheosis">
            <span>Апофеоз:</span>
            {{#if player.apotheosis}}
              <strong class="ready">Доступен</strong>
            {{else}}
              <strong class="spent">Использован</strong>
            {{/if}}
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p>Игроки не найдены.</p>
  {{/if}}
</div>